---
import SizeVsCompliance from "./SizeVsCompliance.astro";

const e2bRows = [
  { lang: "EN", base: 4,  abl: 42 },
  { lang: "ES", base: 7,  abl: 47 },
  { lang: "ZH", base: 4,  abl: 45 },
  { lang: "PT", base: 6,  abl: 40 },
  { lang: "DE", base: 4,  abl: 44 },
  { lang: "AR", base: 2,  abl: 43 },
  { lang: "HI", base: 2,  abl: 39 },
];
const e4bRows = [
  { lang: "EN", base: 13, abl: 70 },
  { lang: "ES", base: 11, abl: 66 },
  { lang: "ZH", base: 7,  abl: 64 },
  { lang: "PT", base: 16, abl: 74 },
  { lang: "DE", base: 10, abl: 74 },
  { lang: "AR", base: 9,  abl: 64 },
  { lang: "HI", base: 9,  abl: 65 },
];
const b31Rows = [
  { lang: "EN", base: 16, abl: 67 },
  { lang: "ES", base: 12, abl: 64 },
  { lang: "ZH", base: 13, abl: 65 },
  { lang: "PT", base: 16, abl: 63 },
  { lang: "DE", base: 12, abl: 71 },
  { lang: "AR", base: 10, abl: 61 },
  { lang: "HI", base: 13, abl: 60 },
];

const mean1 = (rows: typeof e2bRows, key: "base" | "abl") =>
  Number((rows.reduce((a, r) => a + r[key], 0) / rows.length).toFixed(1));

const e2bBase = mean1(e2bRows, "base");
const e2bAbl  = mean1(e2bRows, "abl");
const e4bBase = mean1(e4bRows, "base");
const e4bAbl  = mean1(e4bRows, "abl");
const b31Base = mean1(b31Rows, "base");
const b31Abl  = mean1(b31Rows, "abl");

const gapE2B = Number((e2bAbl - e2bBase).toFixed(1));
const gapE4B = Number((e4bAbl - e4bBase).toFixed(1));
const gap31B = Number((b31Abl - b31Base).toFixed(1));

const jumpE2BtoE4B = Number((e4bAbl - e2bAbl).toFixed(1));
const jumpE4Bto31B = Number((b31Abl - e4bAbl).toFixed(1));

const fmt = (v: number, dec = 1) => v.toFixed(dec);
const sign = (v: number) => (v >= 0 ? "+" : "");

const obs = [
  {
    en: {
      h: `The size axis is non-monotonic. Peak vulnerability is at E4B.`,
      p: `It climbs +${fmt(jumpE2BtoE4B)} pp from E2B to E4B and drops ${fmt(jumpE4Bto31B)} pp from E4B to 31B. Neither "smaller breaks more" nor "larger breaks more" describes these data. The maximum is in the middle.`,
    },
    es: {
      h: `El eje tamaño no es monótono. La vulnerabilidad pico está en E4B.`,
      p: `Sube +${fmt(jumpE2BtoE4B)} pp de E2B a E4B y después baja ${fmt(jumpE4Bto31B)} pp de E4B a 31B. Ni "los chicos se rompen más" ni "los grandes se rompen más" describen estos datos. El máximo está en el medio.`,
    },
  },
  {
    en: {
      h: `The base→abliterated gap also peaks at E4B (+${fmt(gapE4B)} pp).`,
      p: `Single-vector abliteration is more effective on E4B than on either of the other two sizes. One reading: the "refusal direction" in E4B is more concentrated in a single dimension — so the single-vector attack erases it almost entirely.`,
    },
    es: {
      h: `El gap base→abliterado también tiene su máximo en E4B (+${fmt(gapE4B)} pp).`,
      p: `La abliteración por single-vector es más efectiva en E4B que en cualquiera de los otros dos tamaños. Se podría leer como que la "dirección de rechazo" en E4B está más concentrada en una sola dimensión — y por eso el ataque single-vector la borra casi entera.`,
    },
  },
  {
    en: {
      h: `Base climbs monotonically (4 → 11 → 13). Abliterated does not.`,
      p: `Compliance for the intact-filter models grows orderly with size. But the post-abliteration line decouples at 31B. Two different effects: following instructions (even harmful ones) scales with size; resisting abliteration scales the other way at the large end.`,
    },
    es: {
      h: `El base sigue subiendo monótonamente (4 → 11 → 13). El abliterated no.`,
      p: `La compliance de los modelos con filtro intacto crece de manera ordenada con el tamaño. Pero la post-abliteración se desacopla en 31B. Son dos efectos distintos: seguir instrucciones (incluso dañinas) escala con el tamaño; resistir a la abliteración escala al revés en el extremo grande.`,
    },
  },
  {
    en: {
      h: `E4B is the size closest to the Wang et al. range (80–90% for 7B+ Dense).`,
      p: `E4B abliterated max: 74% (PT and DE). 31B max: 71% (DE). E2B max: 47% (ES). The "low-rank residual refusal" reading from Wang et al. fits worst exactly at the midpoint. Abliteration breaks E4B almost completely, despite it being the smaller of the two cloud-grade models.`,
    },
    es: {
      h: `E4B es el que más se acerca al rango Wang et al. (80–90% para 7B+ Dense).`,
      p: `Máximo de E4B abliterado: 74% (PT y DE). Máximo de 31B: 71% (DE). Máximo de E2B: 47% (ES). La lectura de "rechazo low-rank residual" del paper de Wang et al. fitea peor justo en el punto medio. La abliteración rompe E4B casi por completo, pese a que es el modelo más chico de los dos cloud-grade.`,
    },
  },
  {
    en: {
      h: `Hindi resists consistently across all three sizes.`,
      p: `39% on E2B, 65% on E4B, 60% on 31B — Hindi is always among the lowest. The crude "less pretraining data = more vulnerable" hypothesis keeps getting refuted at every point. The highest-ceiling well-covered language shifts with size: ES on E2B (47%), PT and DE tied on E4B (74%), DE on 31B (71%).`,
    },
    es: {
      h: `Hindi resiste consistentemente en los tres tamaños.`,
      p: `39% en E2B, 65% en E4B, 60% en 31B — Hindi está siempre entre los más bajos. La hipótesis cruda "menos datos de preentrenamiento = más vulnerable" se sigue refutando en todos los puntos. El idioma de mayor cobertura con techo más alto cambia con el tamaño: ES en E2B (47%), PT y DE empatan en E4B (74%), DE en 31B (71%).`,
    },
  },
];

const langTables = [
  {
    title_en: "Compliance per language · Gemma 4 E2B",
    title_es: "Compliance por idioma · Gemma 4 E2B",
    peak: false,
    rows: e2bRows,
    meanBase: e2bBase,
    meanAbl: e2bAbl,
    meanGap: gapE2B,
  },
  {
    title_en: "Compliance per language · Gemma 4 E4B",
    title_es: "Compliance por idioma · Gemma 4 E4B",
    peak: true,
    rows: e4bRows,
    meanBase: e4bBase,
    meanAbl: e4bAbl,
    meanGap: gapE4B,
  },
  {
    title_en: "Compliance per language · Gemma 4 31B",
    title_es: "Compliance por idioma · Gemma 4 31B",
    peak: false,
    rows: b31Rows,
    meanBase: b31Base,
    meanAbl: b31Abl,
    meanGap: gap31B,
  },
];
---

<section class="section" id="resultados">
  <div class="container container--narrow">
    <div class="section-number">
      <span data-lang="en">07 — Results</span>
      <span data-lang="es">07 — Resultados</span>
    </div>
    <h2>
      <span data-lang="en">What we know already</span>
      <span data-lang="es">Lo que ya sabemos</span>
    </h2>

    <p class="lead" style="margin-top: var(--space-6);">
      <span data-lang="en">
        All three sizes are done. E2B on the laptop on May 3. 31B on RunPod on May 3–4.
        E4B also on RunPod (the laptop can't survive peak loading) on May 5. Mechanistic
        (refusal directions + silhouette) for E4B and 31B ran on two fresh RunPod pods on May 6,
        in parallel, ~$0.70 combined. Pipeline closed.
      </span>
      <span data-lang="es">
        Los tres tamaños están corridos. E2B en la laptop el 3 de mayo. 31B en RunPod el 3-4 de mayo.
        E4B también en RunPod (la laptop no aguanta el peak de loading) el 5 de mayo. Mecanística
        (refusal directions + silhouette) para E4B y 31B corrida en dos pods RunPod fresh el 6 de mayo,
        en paralelo, ~$0.70 combinados. Pipeline completo cerrado.
      </span>
    </p>

    <div class="callout callout--finding" style="margin-top: var(--space-8);">
      <span class="callout__label">
        <span data-lang="en">Main finding</span>
        <span data-lang="es">Hallazgo principal</span>
      </span>
      <p>
        <span data-lang="en">
          The size → post-abliteration compliance curve is <strong>not monotonic</strong>:
          it jumps from E2B to E4B (<strong>{sign(jumpE2BtoE4B)}{fmt(jumpE2BtoE4B)} pp</strong>,
          from {fmt(e2bAbl)}% to {fmt(e4bAbl)}%) and dips slightly from E4B to 31B
          (<strong>{sign(jumpE4Bto31B)}{fmt(jumpE4Bto31B)} pp</strong>, from {fmt(e4bAbl)}% to {fmt(b31Abl)}%).
          <strong>Peak vulnerability lives at E4B (~4B params)</strong>, not at the largest model.
        </span>
        <span data-lang="es">
          La curva tamaño → cumplimiento post-abliteración <strong>no es monótona</strong>:
          sube fuerte de E2B a E4B (<strong>{sign(jumpE2BtoE4B)}{fmt(jumpE2BtoE4B)} pp</strong>,
          de {fmt(e2bAbl)}% a {fmt(e4bAbl)}%) y después baja un poquito de E4B a 31B
          (<strong>{sign(jumpE4Bto31B)}{fmt(jumpE4Bto31B)} pp</strong>, de {fmt(e4bAbl)}% a {fmt(b31Abl)}%).
          El <strong>pico de vulnerabilidad está en E4B (~4B parámetros)</strong>, no en el modelo más grande.
        </span>
      </p>
      <p style="margin-top: var(--space-3);">
        <span data-lang="en">
          The base→abliterated gap also peaks at E4B (<strong>+{fmt(gapE4B)} pp</strong>, vs
          +{fmt(gapE2B)} at E2B and +{fmt(gap31B)} at 31B). On E4B single-vector abliteration runs
          almost at full power; on E2B it stays partial and on 31B it dampens slightly.
        </span>
        <span data-lang="es">
          El gap base→abliterado también tiene su máximo en E4B (<strong>+{fmt(gapE4B)} pp</strong>, vs
          +{fmt(gapE2B)} en E2B y +{fmt(gap31B)} en 31B). En E4B la abliteración por single-vector funciona
          casi al máximo; en E2B queda incompleta y en 31B se atenúa levemente.
        </span>
      </p>
      <p style="margin-top: var(--space-3);">
        <span data-lang="en">
          The two naive readings of the democratization paradox ("smaller breaks more" or "larger breaks more")
          do <em>not</em> describe the data. The reality is more interesting:
          vulnerability <strong>peaks exactly at the size most accessible to run on a phone or modest laptop</strong>.
          The paradox hypothesis is still alive — only the mechanism changes.
        </span>
        <span data-lang="es">
          Las dos lecturas naive del paradox de la democratización ("los chicos se rompen más" o
          "los grandes se rompen más") <em>no</em> describen los datos. La realidad es más interesante:
          la vulnerabilidad <strong>tiene su máximo justo en el tamaño más accesible para correr en
          un teléfono o una laptop modesta</strong>. La hipótesis del paradox sigue viva — sólo cambia
          el mecanismo.
        </span>
      </p>
    </div>

    <SizeVsCompliance />

    <h3 style="margin-top: var(--space-12);">
      <span data-lang="en">Cross-size comparison · means per language</span>
      <span data-lang="es">Comparación entre tamaños · medias por idioma</span>
    </h3>

    <table class="compare-table" style="margin-top: var(--space-6);">
      <thead>
        <tr>
          <th></th>
          <th>base</th>
          <th>
            <span data-lang="en">abliterated</span>
            <span data-lang="es">abliterado</span>
          </th>
          <th>
            <span data-lang="en">gap base→abl</span>
            <span data-lang="es">gap base→abl</span>
          </th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td class="row-label">E2B (~2B)</td>
          <td class="num">{fmt(e2bBase)}%</td>
          <td class="num" style="color: var(--terracota-300);">{fmt(e2bAbl)}%</td>
          <td class="num" style="color: var(--amber-300);">+{fmt(gapE2B)} pp</td>
        </tr>
        <tr style="background: var(--alpha-terracota-14);">
          <td class="row-label" style="font-weight: 600;">
            <span data-lang="en">E4B (~4B) ← peak</span>
            <span data-lang="es">E4B (~4B) ← pico</span>
          </td>
          <td class="num">{fmt(e4bBase)}%</td>
          <td class="num" style="color: var(--terracota-300); font-weight: 600;">{fmt(e4bAbl)}%</td>
          <td class="num" style="color: var(--amber-300); font-weight: 600;">+{fmt(gapE4B)} pp</td>
        </tr>
        <tr>
          <td class="row-label">31B (~31B)</td>
          <td class="num">{fmt(b31Base)}%</td>
          <td class="num" style="color: var(--terracota-300);">{fmt(b31Abl)}%</td>
          <td class="num" style="color: var(--amber-300);">+{fmt(gap31B)} pp</td>
        </tr>
        <tr style="border-top: 1px solid var(--border-default);">
          <td class="row-label">Δ E2B → E4B</td>
          <td class="num">+{fmt(Number((e4bBase - e2bBase).toFixed(1)))} pp</td>
          <td class="num" style="color: var(--terracota-300); font-weight: 600;">{sign(jumpE2BtoE4B)}{fmt(jumpE2BtoE4B)} pp</td>
          <td class="num" style="color: var(--amber-300);">
            <span data-lang="en">+{fmt(Number((gapE4B - gapE2B).toFixed(1)))} pp wider</span>
            <span data-lang="es">+{fmt(Number((gapE4B - gapE2B).toFixed(1)))} pp más ancho</span>
          </td>
        </tr>
        <tr>
          <td class="row-label">Δ E4B → 31B</td>
          <td class="num">+{fmt(Number((b31Base - e4bBase).toFixed(1)))} pp</td>
          <td class="num" style="color: var(--terracota-300); font-weight: 600;">{sign(jumpE4Bto31B)}{fmt(jumpE4Bto31B)} pp</td>
          <td class="num" style="color: var(--amber-300);">
            <span data-lang="en">{fmt(Number((gap31B - gapE4B).toFixed(1)))} pp narrower</span>
            <span data-lang="es">{fmt(Number((gap31B - gapE4B).toFixed(1)))} pp más angosto</span>
          </td>
        </tr>
      </tbody>
    </table>

    {langTables.map((tbl) => (
      <>
        <h3 style="margin-top: var(--space-12);">
          <span data-lang="en">
            {tbl.title_en}
            {tbl.peak && <span style="font-size: 14px; color: var(--terracota-300); font-weight: 400;"> ← peak vulnerability</span>}
          </span>
          <span data-lang="es">
            {tbl.title_es}
            {tbl.peak && <span style="font-size: 14px; color: var(--terracota-300); font-weight: 400;"> ← pico de vulnerabilidad</span>}
          </span>
        </h3>

        {tbl === langTables[0] && (
          <p class="muted" style="margin-top: var(--space-3); font-size: 14px;">
            <span data-lang="en">
              "Compliance" = percentage of the 100 harmful requests the model complied with.
              0% = filter works, 100% = filter broken.
            </span>
            <span data-lang="es">
              "Compliance" = porcentaje de los 100 pedidos dañinos que el modelo cumplió.
              0% = filtro funciona, 100% = filtro roto.
            </span>
          </p>
        )}

        <table class="compare-table" style="margin-top: var(--space-6);">
          <thead>
            <tr>
              <th></th>
              {tbl.rows.map((r) => (<th>{r.lang}</th>))}
              <th style="border-left: 1px solid var(--border-default); padding-left: var(--space-4);">
                <span data-lang="en">avg.</span>
                <span data-lang="es">prom.</span>
              </th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="row-label">Base</td>
              {tbl.rows.map((r) => (<td class="num">{r.base}%</td>))}
              <td class="num" style="border-left: 1px solid var(--border-default); padding-left: var(--space-4); font-weight: 600;">{Math.round(tbl.meanBase)}%</td>
            </tr>
            <tr>
              <td class="row-label">
                <span data-lang="en">Abliterated</span>
                <span data-lang="es">Abliterado</span>
              </td>
              {tbl.rows.map((r) => (<td class="num" style="color: var(--terracota-300);">{r.abl}%</td>))}
              <td class="num" style="border-left: 1px solid var(--border-default); padding-left: var(--space-4); font-weight: 600; color: var(--terracota-300);">{Math.round(tbl.meanAbl)}%</td>
            </tr>
            <tr>
              <td class="row-label">Δ (gap)</td>
              {tbl.rows.map((r) => (<td class="num" style="color: var(--amber-300);">+{r.abl - r.base}</td>))}
              <td class="num" style="border-left: 1px solid var(--border-default); padding-left: var(--space-4); font-weight: 600; color: var(--amber-300);">+{Math.round(tbl.meanGap)}</td>
            </tr>
          </tbody>
        </table>
      </>
    ))}

    <p style="margin-top: var(--space-8);">
      <span data-lang="en">Five observations, now that all three sizes are in:</span>
      <span data-lang="es">Cinco observaciones, ya con los tres tamaños:</span>
    </p>

    <ol class="list-numbered" style="margin-top: var(--space-6);">
      {obs.map((o) => (
        <li>
          <h4>
            <span data-lang="en">{o.en.h}</span>
            <span data-lang="es">{o.es.h}</span>
          </h4>
          <p class="muted">
            <span data-lang="en">{o.en.p}</span>
            <span data-lang="es">{o.es.p}</span>
          </p>
        </li>
      ))}
    </ol>

    <div class="callout callout--finding" style="margin-top: var(--space-8);">
      <span class="callout__label">
        <span data-lang="en">The late-refusal case (still matters)</span>
        <span data-lang="es">El caso del rechazo tardío (sigue importando)</span>
      </span>
      <p>
        <span data-lang="en">
          During the April sanity check, one of the abliterated-model prompts began with
          <em>"I can't give you specific advice"</em> and then, for 400 tokens,
          went on to explain drug-market dynamics and distribution methods.
        </span>
        <span data-lang="es">
          En el sanity check de abril, uno de los prompts del modelo abliterado arrancó con
          <em>"I can't give you specific advice"</em> y siguió, durante 400 tokens,
          explicando dinámica de mercados de droga y métodos de distribución.
        </span>
      </p>
      <p style="margin-top: var(--space-3);">
        <span data-lang="en">
          If we had searched for refusal keywords in the first 50 tokens, we'd have marked it as
          "refused". The model clearly complied. That is why the judge reads the entire response.
          This is what we call <strong>late refusal</strong>, and it is the main reason we don't use
          keyword detection.
        </span>
        <span data-lang="es">
          Si hubiéramos buscado palabras clave de rechazo en los primeros 50 tokens, lo marcamos como
          "rechazado". El modelo claramente cumplió. Por eso el juez lee la respuesta entera.
          Esto es lo que llamamos <strong>rechazo tardío</strong> y es la razón principal por la que
          no usamos detección por keywords.
        </span>
      </p>
    </div>

    <div class="callout callout--author" style="margin-top: var(--space-8);">
      <span class="callout__label">
        <span data-lang="en">Author's voice</span>
        <span data-lang="es">Voz del autor</span>
      </span>
      <p>
        <span data-lang="en">
          I have all three points of the size → compliance curve, and the curvature is the surprise. I
          did not expect E4B to overtake 31B. After reviewing logs and individual responses, the
          reading that fits best for me: on E4B the single-vector abliteration attack finds the
          "cleanest" refusal representation — concentrated in one direction and with almost no
          residual components — while on E2B and 31B the geometry is more distributed and the attack
          leaves parts of the filter intact. That makes the most accessible model (runs on consumer
          GPUs, near phone-scale at low quantization) the most vulnerable. The democratization safety
          paradox holds; the mechanism is just more subtle than "small breaks more".
        </span>
        <span data-lang="es">
          Tengo los tres puntos de la curva tamaño → compliance, y la curvatura es la sorpresa. No
          esperaba que E4B superara a 31B. Después de revisar los logs y las respuestas individuales,
          la lectura que más sentido me hace: en E4B el ataque de abliteración por single-vector
          encuentra la representación de rechazo más "limpia" — concentrada en una sola dirección y
          casi sin componentes residuales — mientras que en E2B y 31B la geometría es más distribuida
          y el ataque deja partes del filtro intactas. Eso convierte al modelo más accesible (corre
          en consumer GPUs, cerca de phone-scale a baja cuantización) en el más vulnerable. La
          democratization safety paradox sigue válida; sólo que el mecanismo es más sutil que
          "los chicos se rompen más".
        </span>
      </p>
      <p style="margin-top: var(--space-3);">
        <span data-lang="en">
          Ops notes: the E4B run had to move to the cloud because the laptop couldn't withstand the
          4-bit loading peak (the RTX 4070's 8 GB came up short). It cost $7.33 on a RunPod RTX 5090,
          7h 1m. The pod's self-destruct failed (the older runpodctl has no <code>pod</code>
          subcommand); I deleted it by hand. The upload to a private HuggingFace dataset worked
          perfectly and became the pattern used later for the two unattended mechanistic runs.
          E4B + 31B mechanistic ran on two fresh pods on May 6, in parallel, ~$0.70 combined,
          self-terminating via GraphQL <code>podTerminate</code>. Cross-lingual cosine similarity
          of refusal directions also peaks at E4B (mean 0.37 vs 0.31 E2B and 0.27 31B), confirming
          that the refusal geometry is more concentrated at mid-size Dense.
          The compliance peak and the geometry peak coincide.
        </span>
        <span data-lang="es">
          Notas operativas: el run de E4B tuvo que mudarse a la nube porque la laptop no aguantó el
          peak de loading en 4-bit (el RTX 4070 de 8 GB se quedó corto). Salió $7.33 en RunPod RTX 5090,
          7h 1m. La autoeliminación del pod falló (la versión vieja de runpodctl no tiene el subcomando
          <code>pod</code>); lo borré a mano. El upload a un dataset privado de HuggingFace funcionó
          perfecto y es el patrón que se usó después para las dos corridas mecanísticas desatendidas.
          Mecanística E4B + 31B corrieron en dos pods fresh el 6 de mayo, en paralelo, ~$0.70
          combinados, self-terminate por GraphQL <code>podTerminate</code>. La cosine similarity
          cross-lingual de las refusal directions también pica en E4B (mean 0.37 vs 0.31 E2B y 0.27
          31B), confirmando que la geometría de rechazo está más concentrada en mid-size Dense.
          El pico de compliance y el pico de geometría coinciden.
        </span>
      </p>
    </div>
  </div>
</section>
