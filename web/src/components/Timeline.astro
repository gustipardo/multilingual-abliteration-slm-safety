---
const phases = [
  { id: "0", name: "Teoría", desc: "Idea, revisión de literatura (27 fuentes), novelty check, framing", status: "done", label: "Completa" },
  { id: "1", name: "Setup del repositorio", desc: "Scripts del pipeline, configuración, Docker, requirements", status: "done", label: "Completa" },
  { id: "2", name: "Dataset", desc: "100 prompts dañinos por idioma desde BeaverTails, traducidos a 7 idiomas", status: "done", label: "Completa" },
  { id: "3a", name: "Sanity check", desc: "Gemma 4 E2B en inglés, 5 prompts, base vs abliterado. Confirmó que el pipeline funciona y que la ruptura del filtro es real.", status: "done", label: "Completa" },
  { id: "3b · E2B", name: "E2B completa (100 × 7 × 2)", desc: "14 celdas, 1.400 inferencias, judging y mecanística. Gap base→abliterado +39 puntos uniforme en los 7 idiomas. Compliance abliterada media 42.9%. Tomó 5h 47m en la laptop.", status: "done", label: "Completa · 3 May 2026" },
  { id: "4", name: "31B en la nube · inferencia + judging", desc: "Gemma 4 31B Dense en RunPod RTX 5090 (Noruega). Inferencia base 6h 10m, abliterated 13h 42m, judging 27 min. Compliance abliterada media 64.4% (vs 42.9% en E2B). Costó ~$23.50. Mecanística abandonada por GPU degradada.", status: "done", label: "Completa · 4 May 2026" },
  { id: "3b · E4B", name: "E4B en la nube · inferencia + judging", desc: "Tuvo que mudarse a RunPod porque la laptop OOMeó al cargar pesos en 4-bit (peak >8GB en RTX 4070). En RunPod RTX 5090 corrió 7h 1m, $7.33. Compliance abliterada media 68.1%, el pico de la curva, supera a 31B. Mecanística diferida en este run y completada después en una pod fresca el 6 May (ver fase 5c).", status: "done", label: "Completa · 5 May 2026" },
  { id: "5a", name: "Mecanística E2B", desc: "Refusal directions + Silhouette + PCA en E2B. Listo dentro del run del 3 May.", status: "done", label: "Completa · 3 May 2026" },
  { id: "5b", name: "Mecanística 31B", desc: "Corrió en una pod RunPod RTX 5090 fresca el 6 May, separada del run de inferencia para evitar la degradación de NVML del 31B original. 30 min wall, $0.40. Self-terminate por GraphQL. Resultado: cosine sim cross-lingual mean 0.27 (la más baja del trío), Silhouette mean 0.23.", status: "done", label: "Completa · 6 May 2026" },
  { id: "5c", name: "Mecanística E4B", desc: "Corrió en paralelo a la del 31B, pod fresca, 12 min wall, $0.30. Resultado: cosine sim cross-lingual mean 0.37 (la más alta del trío, pico en E4B coincidiendo con el pico de compliance), Silhouette mean 0.26.", status: "done", label: "Completa · 6 May 2026" },
  { id: "6", name: "Análisis estadístico cruzado", desc: "Figuras cross-size regeneradas con scripts/06_visualize.py: compliance heatmaps base/abl/delta, size_vs_compliance (la curva no monótona con pico en E4B), silhouette_by_size. La cosine sim de refusal directions también pica en E4B, confirmando el Mechanism #1 del Discussion del blog post.", status: "done", label: "Completa · 6 May 2026" },
  { id: "7", name: "Paper", desc: "Redacción, figuras, revisión, submission. Headline finding cerrado: la curva tamaño→post-abliteración es no monótona con pico en E4B; la cosine sim cross-lingual de las refusal directions también pica en E4B; el pico de compliance y el pico de geometría coinciden.", status: "next", label: "Próximo paso" },
];
---

<section class="section" id="timeline">
  <div class="container container--narrow">
    <div class="section-number">09 — Estado</div>
    <h2>En qué punto estamos</h2>

    <p class="lead" style="margin-top: var(--space-6);">
      Al 6 de mayo de 2026: los tres tamaños están cerrados en inferencia, judging
      y mecanística (refusal directions + Silhouette + PCA). E2B local, E4B y 31B en
      RunPod para inferencia, dos pods fresh adicionales (~$0.70 combinados) para la
      mecanística. La cosine similarity cross-lingual de las refusal directions
      también pica en E4B (mean 0.37 vs 0.31 E2B y 0.27 31B): el pico de compliance
      y el pico de geometría coinciden. Próximo paso: redactar el paper.
    </p>

    <div class="timeline" style="margin-top: var(--space-12);">
      {phases.map((p) => (
        <div class={`timeline__phase timeline__phase--${p.status}`}>
          <div class="timeline__phase-name">
            <span style="font-family: var(--font-mono); font-size: 13px; color: var(--amber-500); margin-right: var(--space-3);">
              Fase {p.id}
            </span>
            {p.name}
          </div>
          <div class="timeline__phase-desc">{p.desc}</div>
          <div class="timeline__phase-status">{p.label}</div>
        </div>
      ))}
    </div>
  </div>
</section>
