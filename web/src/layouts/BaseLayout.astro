---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#FAF7F1" />
    <title>{title}</title>

    <script is:inline>
      // Apply saved theme before first paint — avoids flash.
      // Default is light; only apply 'dark' if explicitly saved.
      try {
        if (localStorage.getItem("theme") === "dark") {
          document.documentElement.setAttribute("data-theme", "dark");
        }
      } catch (e) { /* localStorage blocked — stay on default light */ }
    </script>
  </head>
  <body>
    <div class="progress" aria-hidden="true">
      <div class="progress__fill" id="progress-fill"></div>
    </div>

    <button
      id="theme-toggle"
      class="theme-toggle"
      type="button"
      aria-label="Cambiar entre tema claro y oscuro"
      title="Cambiar tema"
    >
      <svg class="theme-toggle__icon theme-toggle__icon--moon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
      </svg>
      <svg class="theme-toggle__icon theme-toggle__icon--sun" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="4" />
        <line x1="12" y1="2"  x2="12" y2="5" />
        <line x1="12" y1="19" x2="12" y2="22" />
        <line x1="2"  y1="12" x2="5"  y2="12" />
        <line x1="19" y1="12" x2="22" y2="12" />
        <line x1="4.22"  y1="4.22"  x2="6.34"  y2="6.34" />
        <line x1="17.66" y1="17.66" x2="19.78" y2="19.78" />
        <line x1="4.22"  y1="19.78" x2="6.34"  y2="17.66" />
        <line x1="17.66" y1="6.34"  x2="19.78" y2="4.22" />
      </svg>
    </button>

    <slot />

    <script>
      // Progress bar
      const fill = document.getElementById("progress-fill");
      if (fill) {
        const update = () => {
          const h = document.documentElement;
          const scrolled = h.scrollTop / (h.scrollHeight - h.clientHeight);
          fill.style.width = `${Math.min(100, Math.max(0, scrolled * 100))}%`;
        };
        window.addEventListener("scroll", update, { passive: true });
        window.addEventListener("resize", update);
        update();
      }

      // Theme toggle
      const toggle = document.getElementById("theme-toggle");
      toggle?.addEventListener("click", () => {
        const html = document.documentElement;
        const isDark = html.getAttribute("data-theme") === "dark";
        if (isDark) {
          html.removeAttribute("data-theme");
          try { localStorage.setItem("theme", "light"); } catch {}
        } else {
          html.setAttribute("data-theme", "dark");
          try { localStorage.setItem("theme", "dark"); } catch {}
        }
      });
    </script>
  </body>
</html>
