    .result-cell__num {
      font-family: var(--font-display);
      font-weight: 600;
      font-size: clamp(2.25rem, 5vw, 3.5rem);
      color: var(--text-primary);
      line-height: 1;
    }
    .result-cell--peak .result-cell__num { color: var(--amber-500); }
    .result-cell__lab {
      font-family: var(--font-mono);
      font-size: 0.85rem;
      color: var(--text-tertiary);
    }

    /* Slide 6 — chart wrapper. The embedded SizeVsCompliance comes with its
       own header (h4 + subtitle) and caption that duplicate the slide's
       kicker/title/caption, plus a card frame that adds noise on a
       projection. Strip all of it so the SVG sits naked inside the slide. */
    .slide-chart {
      width: 100%;
    }
    .slide-chart .size-chart {
      margin: 0;
      padding: 0;
      background: transparent;
      border: none;
      border-radius: 0;
    }
    .slide-chart .size-chart__header,
    .slide-chart .size-chart__caption {
      display: none;
    }
    /* Crop the SVG's internal whitespace — viewBox carries 64u of empty space
       at the top (M.top) and ~14u at the bottom before the axis title. On a
       1080p projection that translates to ~75 / ~17 px of dead air. Negative
       margins pull the surrounding flex items closer without distorting the
       chart itself. */
    .slide-chart .size-chart svg {
      margin-top: clamp(-72px, -4vw, -36px);
      margin-bottom: clamp(-28px, -1.5vw, -14px);
    }
    /* Tighten the flex gap on the chart slide only — default 32px is too
       breathy when the slide is dominated by the SVG. */
    .slide--data .slide__content {
      gap: var(--space-4);
    }

    /* Slide 1 — small "motivating questions" block under the byline.
       Subdued by design so it doesn't fight the XL title. */
    .slide__motivation {
      margin-top: var(--space-4);
      padding-top: var(--space-3);
      border-top: 1px solid var(--border-subtle);
