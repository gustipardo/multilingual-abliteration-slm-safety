---
// IntroAnimation.astro — slide 1 cover. Sparse "neural net" of amber nodes wakes inside a
// phone outline over ~5s, pulses once, then holds with a subtle breath. Import:
//   import IntroAnimation from "../components/animations/IntroAnimation.astro";

const dots: Array<[number, number]> = [
  [200, 115], [245, 123], [305, 110], [368, 118], [412, 113],
  [188, 170], [253, 159], [315, 167], [352, 173], [415, 160],
  [203, 212], [246, 222], [310, 209], [360, 225], [406, 216],
  [197, 271], [258, 257], [302, 269], [366, 264], [413, 272],
  [190, 313], [256, 324], [306, 310], [352, 315], [418, 321],
  [204, 367], [248, 358], [312, 369], [355, 362], [408, 370],
  [199, 415], [241, 421], [307, 411], [368, 422], [414, 413],
  [201, 464], [250, 470], [298, 462], [364, 473], [409, 465],
];

// Sparse edges (~50). Each pair refers to dot indices above.
const edges: Array<[number, number]> = [
  [0, 1], [2, 3], [3, 4], [5, 6], [7, 8], [10, 11], [11, 12], [13, 14],
  [15, 16], [17, 18], [20, 21], [22, 23], [23, 24], [25, 26], [27, 28],
  [30, 31], [32, 33], [35, 36], [37, 38], [38, 39],
  [0, 5], [2, 7], [4, 9], [6, 11], [8, 13], [10, 15], [12, 17], [14, 19],
  [16, 21], [18, 23], [20, 25], [22, 27], [24, 29], [26, 31], [28, 33],
  [30, 35], [32, 37], [34, 39], [1, 6], [3, 8],
  [0, 6], [4, 8], [11, 17], [15, 21], [19, 23], [25, 31], [33, 39],
  [30, 36], [13, 18], [5, 11], [9, 14],
];
---

<div class="intro-anim" aria-hidden="true">
  <svg viewBox="0 0 600 600" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <clipPath id="introPhoneClip">
        <rect x="156" y="66" width="288" height="468" rx="28" ry="28" />
      </clipPath>
    </defs>

    {/* phone outline */}
    <g class="phone">
      <rect x="150" y="60" width="300" height="480" rx="34" ry="34"
            fill="none" stroke="#11182A" stroke-width="2.5" />
      <rect x="270" y="78" width="60" height="5" rx="2.5" fill="#11182A" opacity="0.55" />
      <circle cx="300" cy="518" r="6" fill="none" stroke="#11182A" stroke-width="1.5" opacity="0.55" />
    </g>

    {/* network */}
    <g class="network" clip-path="url(#introPhoneClip)">
      <g class="edges" stroke="#B87826" stroke-width="0.75" stroke-linecap="round" fill="none">
        {edges.map(([a, b]) => {
          const order = Math.max(a, b);
          return (
            <line
              x1={dots[a][0]} y1={dots[a][1]}
              x2={dots[b][0]} y2={dots[b][1]}
              style={`--i:${order}`}
            />
          );
        })}
      </g>
      <g class="nodes" fill="#B87826">
        {dots.map(([x, y], i) => (
          <circle cx={x} cy={y} r="2.6" style={`--i:${i}`} />
        ))}
      </g>
    </g>
  </svg>
</div>

<style>
  .intro-anim {
    width: 100%;
    max-width: 600px;
    margin: 0 auto;
    aspect-ratio: 1 / 1;
    background: #FAF7F1;
  }
  .intro-anim svg { width: 100%; height: 100%; display: block; }

  /* nodes fade in, one every 75ms */
  .intro-anim .nodes circle {
    opacity: 0;
    animation: introNodeIn 0.45s cubic-bezier(.4, 0, .2, 1) forwards;
    animation-delay: calc(var(--i) * 75ms);
  }

  /* edges draw in just after their later endpoint lights up */
  .intro-anim .edges line {
    stroke-dasharray: 240;
    stroke-dashoffset: 240;
    opacity: 0;
    animation: introEdgeIn 0.55s cubic-bezier(.4, 0, .2, 1) forwards;
    animation-delay: calc(var(--i) * 75ms + 90ms);
  }

  /* whole network pulses once at 4s, then breathes forever */
  .intro-anim .network {
    transform-box: fill-box;
    transform-origin: center;
    animation:
      introPulse   1.1s cubic-bezier(.4, 0, .2, 1) 4s   1 both,
      introBreathe 4s   ease-in-out                5.1s infinite;
  }

  @keyframes introNodeIn {
    from { opacity: 0; }
    to   { opacity: 1; }
  }
  @keyframes introEdgeIn {
    0%   { stroke-dashoffset: 240; opacity: 0; }
    100% { stroke-dashoffset: 0;   opacity: 0.55; }
  }
  @keyframes introPulse {
    0%   { transform: scale(1);    filter: drop-shadow(0 0 0    rgba(184, 120, 38, 0)); }
    50%  { transform: scale(1.05); filter: drop-shadow(0 0 14px rgba(184, 120, 38, 0.45)); }
    100% { transform: scale(1);    filter: drop-shadow(0 0 0    rgba(184, 120, 38, 0)); }
  }
  @keyframes introBreathe {
    0%, 100% { transform: scale(1);    }
    50%      { transform: scale(1.02); }
  }

  @media (prefers-reduced-motion: reduce) {
    .intro-anim .nodes circle,
    .intro-anim .edges line,
    .intro-anim .network {
      animation: none !important;
      opacity: 1 !important;
      stroke-dashoffset: 0 !important;
      transform: none !important;
      filter: none !important;
    }
    .intro-anim .edges line { opacity: 0.55 !important; }
  }
</style>
