      margin: 0;
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
      font-family: var(--font-body);
      font-size: clamp(0.8rem, 1vw, 0.95rem);
      line-height: 1.45;
      color: var(--text-secondary);
