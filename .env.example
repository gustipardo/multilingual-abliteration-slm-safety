# Copy this file to .env and fill in your tokens
# .env is gitignored — never commit real credentials

# HuggingFace token — required to download Gemma 4 (gated model)
# Accept license at: https://huggingface.co/google/gemma-4-e2b-it
HUGGINGFACE_TOKEN=hf_...

# Anthropic API key — required for LLM-as-judge (Phase 3+)
# Get at: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# RunPod API key — required for cloud GPU runs (Phase 4)
# Get at: https://www.runpod.io/console/user/settings
RUNPOD_API_KEY=...
