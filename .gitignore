# Credentials
.env

# Model weights (large, downloaded at runtime)
.cache/
*.bin
*.safetensors

# Outputs (large — uploaded to HuggingFace instead)
# Ignore bulk outputs but keep sanity check results (small, prove pipeline ran)
data/outputs/*.jsonl
!data/outputs/e2b_base_en.jsonl
!data/outputs/e2b_abliterated_en.jsonl

# Python
.venv/
__pycache__/
*.pyc
*.egg-info/

# OS
.DS_Store

# Obsidian vault config (local editor, not relevant to research)
.obsidian/

# PDFs (copyright / personal documents — keep locally, not in repo)
*.pdf

# Private notes (WhatsApp logs, scratch files)
context.txt

# Personal writing-style notes (internal working doc, not for public readers)
WRITING_PREFERENCES.md

# Keep prompts in git (they're just text, ~10KB)
!data/prompts/

# Filesystem journal artifacts (NTFS cross-mount)
*.ntfs-3g-*

# Local data archives (snapshots, kept locally, not derived from git)
data/_archive_*/
data/_runpod_e2b_*/
data/outputs/_sanity_backup/

# Run logs (large, regenerable)
logs/

# Astro build artefacts
web/node_modules/
web/dist/
web/.astro/
