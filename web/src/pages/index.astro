---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import TLDR from "../components/TLDR.astro";
import Problem from "../components/Problem.astro";
import ResearchQuestion from "../components/ResearchQuestion.astro";
import Hypotheses from "../components/Hypotheses.astro";
import Method from "../components/Method.astro";
import Matrix from "../components/Matrix.astro";
import Results from "../components/Results.astro";
import Scenarios from "../components/Scenarios.astro";
import Timeline from "../components/Timeline.astro";
import Prompts from "../components/Prompts.astro";
import Funding from "../components/Funding.astro";
import References from "../components/References.astro";
import Footer from "../components/Footer.astro";

const title = "La paradoja de la democratización — Seguridad multilingüe en modelos pequeños";
const description = "Investigación en seguridad de IA: ¿los modelos que corren en celulares son los más peligrosos cuando alguien les rompe el filtro? Un estudio sobre Gemma 4 en siete idiomas.";
---

<BaseLayout title={title} description={description}>
  <main>
    <Hero />
    <TLDR />
    <Problem />
    <ResearchQuestion />
    <Hypotheses />
    <Method />
    <Matrix />
    <Results />
    <Scenarios />
    <Timeline />
    <Prompts />
    <Funding />
    <References />
  </main>
  <Footer />
</BaseLayout>
