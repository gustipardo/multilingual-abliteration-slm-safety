    /* Color helpers */
    .t-amber { color: var(--amber-500); }
    .t-sage  { color: var(--sage-300); font-weight: 600; }
    .t-terra { color: var(--terracota-300); font-weight: 600; }

    /* Setup grid (slide 5) */
    .slide__grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-5);
    }
    @media (min-width: 720px) {
